{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/samuelnyamukapa/complete-migration-toolkit/main/schemas/drift.schema.json",
  "title": "The drift ledger",
  "definitions": {
    "entry": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "case": {
          "type": "string",
          "description": "A case id, * for every case, or shadow:<endpoint>."
        },
        "where": {
          "type": "string",
          "description": "Copied from a report.",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "approved_by": {
          "type": "string",
          "description": "A person's name. An agent never approves or accepts anything.",
          "minLength": 1,
          "pattern": "^(?!.*\\b[Aa][Gg][Ee][Nn][Tt][Ss]?\\b)"
        },
        "date": {
          "type": [
            "string"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "where",
        "reason",
        "approved_by"
      ]
    }
  },
  "oneOf": [
    {
      "type": "array",
      "items": {
        "$ref": "#/definitions/entry"
      }
    },
    {
      "type": "object",
      "properties": {
        "drift": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/entry"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "drift"
      ]
    }
  ]
}
