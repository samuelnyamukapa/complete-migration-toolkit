{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/samuelnyamukapa/complete-migration-toolkit/main/schemas/report.schema.json",
  "title": "REPORT.json from cmtk run or cmtk compare",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "tool",
    "mode",
    "system",
    "date",
    "verdict",
    "targets",
    "counts",
    "cases",
    "contracts",
    "requirements",
    "unused_drift",
    "suggested_scrubs",
    "partial",
    "reason",
    "next"
  ],
  "properties": {
    "tool": {
      "const": "cmtk"
    },
    "mode": {
      "enum": [
        "run",
        "compare"
      ]
    },
    "system": {
      "type": "string"
    },
    "date": {
      "type": "string"
    },
    "verdict": {
      "enum": [
        "PASS",
        "PASS WITH KNOWN ISSUES",
        "FAIL",
        "PARITY",
        "DRIFT ONLY",
        "NO PARITY",
        "PARTIAL COMPARISON",
        "INCOMPLETE",
        "NO EVIDENCE"
      ]
    },
    "targets": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer"
      }
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "requirement",
          "surface",
          "result"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "request": {
            "type": "string"
          },
          "inputs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "path",
                "sha256",
                "bytes"
              ],
              "properties": {
                "path": {
                  "type": "string"
                },
                "sha256": {
                  "type": "string"
                },
                "bytes": {
                  "type": "integer"
                },
                "field": {
                  "type": "string"
                },
                "filename": {
                  "type": "string"
                },
                "content_type": {
                  "type": "string"
                },
                "as": {
                  "const": "form"
                }
              }
            }
          },
          "before": {
            "type": "object",
            "required": [
              "request",
              "took",
              "cookies"
            ],
            "properties": {
              "request": {
                "type": "string"
              },
              "status": {
                "type": "integer"
              },
              "took": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "cookies": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "requirement": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "surface": {
            "type": "string"
          },
          "match": {
            "enum": [
              "exact",
              "semantic",
              "contract"
            ]
          },
          "result": {
            "enum": [
              "PASS",
              "FAIL",
              "MATCH",
              "DRIFT",
              "DIFFERENT",
              "NOT COMPARABLE",
              "SKIPPED",
              "ERROR"
            ]
          },
          "why": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "truncated": {
            "const": true
          },
          "failures": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "check",
                "expected",
                "actual"
              ],
              "properties": {
                "check": {
                  "type": "string"
                },
                "expected": {
                  "type": "string"
                },
                "actual": {
                  "type": "string"
                },
                "known_issue": {
                  "type": "string"
                }
              }
            }
          },
          "differences": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "where",
                "reference",
                "candidate"
              ],
              "properties": {
                "where": {
                  "type": "string"
                },
                "reference": {
                  "type": "string"
                },
                "candidate": {
                  "type": "string"
                },
                "drift": {
                  "type": "string"
                }
              }
            }
          },
          "known_issues": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "contracts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "kind",
          "result",
          "findings"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "result": {
            "enum": [
              "IDENTICAL",
              "EQUIVALENT",
              "COMPATIBLE",
              "BREAKING",
              "REVIEW",
              "ERROR",
              "NOT COMPARABLE"
            ]
          },
          "findings": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "breaking",
                "what"
              ],
              "properties": {
                "breaking": {
                  "type": [
                    "boolean",
                    "null"
                  ]
                },
                "what": {
                  "type": "string"
                },
                "where": {
                  "type": "string"
                },
                "drift": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "requirement",
          "cases",
          "passed",
          "failed",
          "other"
        ],
        "properties": {
          "requirement": {
            "type": "string"
          },
          "cases": {
            "type": "integer"
          },
          "passed": {
            "type": "integer"
          },
          "failed": {
            "type": "integer"
          },
          "other": {
            "type": "integer"
          }
        }
      }
    },
    "unused_drift": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "known_issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "case",
          "fails",
          "reason",
          "accepted_by",
          "state"
        ],
        "properties": {
          "state": {
            "enum": [
              "still fails",
              "no longer fails",
              "not checked"
            ]
          }
        }
      }
    },
    "stale_known_issues": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "suggested_scrubs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "where",
          "cases",
          "why"
        ],
        "properties": {
          "where": {
            "type": "string"
          },
          "cases": {
            "type": "integer"
          },
          "why": {
            "type": "string"
          }
        }
      }
    },
    "partial": {
      "type": "boolean"
    },
    "excluded_drafts": {
      "type": "integer"
    },
    "excluded_compare_only": {
      "type": "integer"
    },
    "scope": {
      "type": "object",
      "required": [
        "whole",
        "statement",
        "compared",
        "not_compared",
        "no_cases",
        "contracts_not_compared"
      ],
      "properties": {
        "whole": {
          "type": "boolean"
        },
        "statement": {
          "type": "string"
        },
        "compared": {
          "type": "array"
        },
        "not_compared": {
          "type": "array"
        },
        "no_cases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "contracts_not_compared": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "settings": {
      "type": "object",
      "required": [
        "manifest",
        "manifest_sha256",
        "match",
        "overrides",
        "scrub",
        "drift_file",
        "drift_entries"
      ],
      "properties": {
        "manifest": {
          "type": "string"
        },
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "match": {
          "enum": [
            "exact",
            "semantic",
            "contract"
          ]
        },
        "overrides": {
          "type": "array"
        },
        "scrub": {
          "type": "object"
        },
        "drift_file": {
          "type": "string"
        },
        "drift_entries": {
          "type": "integer"
        },
        "known_issues_file": {
          "type": "string"
        },
        "known_issues_entries": {
          "type": "integer"
        }
      }
    },
    "scrub_fired": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "reason": {
      "type": "string"
    },
    "next": {
      "type": "string"
    }
  }
}
